{
  "name": "oh-my-mock",
  "version": "3.3.15",
  "scripts": {
    "ng": "ng",
    "ci": "npm ci",
    "start": "ng serve",
    "test-site": "node test-site/server/index.mts",
    "test-site:sdk": "ts-node -P ./tsconfig-server.json ./test-site/server/sdk-server.ts",
    "cleanup": "rimraf dist",
    "replace-tokens": "node ./scripts/token-replace.js",
    "cp:manifest": "ts-node -P ./tsconfig-server.json ./scripts/copy-manifest.ts",
    "ci:build": "npm run cleanup && run-s ci:build:ng ci:build:content ci:build:injected ci:build:sandbox ci:build:offscreen ci:build:background cp:manifest && npm run replace-tokens && npm run ci:minify && npm run ci:build:splash",
    "ci:build:ng": "NG_PERSISTENT_BUILD_CACHE=1 ng build --configuration production --output-hashing none --base-href=index.html",
    "ci:build:content": "webpack -c ./webpack-prd.config.js --entry ./src/content/index.ts --output-filename content.js",
    "ci:build:injected": "webpack -c ./webpack-prd.config.js --entry ./src/injected/index.ts --output-filename oh-my-mock.js",
    "ci:build:sandbox": "webpack -c ./webpack-prd.config.js --entry ./src/sandbox/index.ts --output-filename sandbox.js && cp src/sandbox/sandbox.html ./dist/",
    "ci:build:offscreen": "webpack -c ./webpack-prd.config.js --entry ./src/offscreen/index.ts --output-filename offscreen.js && cp src/offscreen/offscreen.html ./dist/",
    "ci:build:background": "webpack -c ./webpack-prd.config.js --entry ./src/background/background.ts --output-filename background.js",
    "ci:build:splash": "cp src/splash-screen.html ./dist",
    "ci:minify": "run-p ci:minify:*",
    "ci:minify:content": "uglifyjs ./dist/content.js -c -m -o ./dist/content.min.js && mv ./dist/content.min.js ./dist/content.js",
    "ci:minify:injected": "uglifyjs ./dist/oh-my-mock.js -c -m -o ./dist/oh-my-mock.min.js && mv ./dist/oh-my-mock.min.js ./dist/oh-my-mock.js",
    "ci:minify:background": "uglifyjs ./dist/background.js -c -m -o ./dist/background.min.js && mv ./dist/background.min.js ./dist/background.js",
    "ci:minify:sandbox": "uglifyjs ./dist/sandbox.js -c -m -o ./dist/sandbox.min.js && mv ./dist/sandbox.min.js ./dist/sandbox.js",
    "ci:minify:offscreen": "uglifyjs ./dist/offscreen.js -c -m -o ./dist/offscreen.min.js && mv ./dist/offscreen.min.js ./dist/offscreen.js",
    "build": "npm run cleanup && run-s build:ng build:content build:injected build:sandbox build:offscreen build:background cp:manifest && npm run replace-tokens && npm run ci:build:splash",
    "build:bundles": "run-s build:content build:injected build:sandbox build:offscreen build:background cp:manifest cp:assets replace-tokens",
    "cp:assets": "mkdir -p dist/oh-my-mock && cp -r src/assets dist/oh-my-mock/",
    "build:ng": "NG_PERSISTENT_BUILD_CACHE=1 ng build --configuration dev --base-href=/oh-my-mock/index.html",
    "build:content": "webpack -c ./webpack.config.js --entry ./src/content/index.ts --output-filename content.js",
    "build:injected": "webpack -c ./webpack.config.js --entry ./src/injected/index.ts --output-filename oh-my-mock.js",
    "build:sandbox": "webpack -c ./webpack.config.js --entry ./src/sandbox/index.ts --output-filename sandbox.js && cp src/sandbox/sandbox.html ./dist/",
    "build:offscreen": "webpack -c ./webpack.config.js --entry ./src/offscreen/index.ts --output-filename offscreen.js && cp src/offscreen/offscreen.html ./dist/",
    "build:background": "webpack -c ./webpack.config.js --entry ./src/background/background.ts --output-filename background.js",
    "watch": "npm run cleanup & npm run cp:manifest & run-p watch:* test-site",
    "watch:custom": "ts-node ./scripts/monitor.ts",
    "bundle": "./scripts/make-bundle.sh",
    "bundle:zip": "rimraf oh-my-mock.zip && npm run ci:build && cd dist && zip -r ../oh-my-mock.zip .",
    "test": "jest",
    "lint": "tsc --project tsconfig.json --noEmit && eslint .",
    "e2e": "playwright test",
    "e2e:types": "tsc -p tests/tsconfig.json",
    "e2e:headed": "HEADED=1 playwright test",
    "e2e:debug": "PWDEBUG=1 HEADED=1 playwright test",
    "e2e:report": "playwright show-report test-results/html",
    "e2e:trace": "playwright show-trace",
    "crx": "./scripts/build-crx.sh ./dist ./scripts/dummy.pem",
    "lib:build": "rimraf dist && tsc --build ./tsconfig-sdk.json && cp lib-package.json ./dist/package.json && cp libs/nodejs-sdk/README.md ./dist",
    "lib:release": "yarn lib:build && cp libs/nodejs-sdk/README.md ./dist && cd dist && npm publish --access=public && cd ..",
    "csp:hash": "echo -n ${npm_config_code} | openssl sha256 -binary | openssl base64",
    "test:watch": "jest --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@faker-js/faker": "^10.5.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@ngneat/overview": "^8.1.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngxpert/hot-toast": "^6.4.1",
    "body-parser": "^1.20.3",
    "chokidar": "^3.6.0",
    "compare-versions": "^6.1.1",
    "content-type-parser": "^1.0.2",
    "express": "^4.21.2",
    "jsonpath-plus": "^10.4.0",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "monaco-editor": "^0.55.1",
    "ngx-monaco-editor-v2": "^22.0.4",
    "rxjs": "^7.8.2",
    "sass": "^1.83.0",
    "scss-reset": "^1.4.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.0.287",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.2",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.17.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.3.11",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "uglify-js": "^3.19.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
