{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "types": [],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "strict": false,
    "esModuleInterop": false
  },
  "files": [
    "src/content/index.ts",
    "src/background/background.ts",
    "src/injected/index.ts"
  ]
}
