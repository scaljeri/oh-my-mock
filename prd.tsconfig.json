{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "types": [],
    "skipLibCheck": true,
    "noEmitOnError": true,
    // NOT strict yet, and that matters: the extension bundles (content,
    // injected, background) compile through this config rather than through
    // tsconfig.app.json, so the mocking logic — where the real bugs have turned
    // up — is the one part strict mode does not cover. Switching this on
    // reports 199 errors; that is the next piece of work, tracked, not ignored.
    "strict": false,
    "esModuleInterop": true
  },
  "files": [
    "src/content/index.ts",
    "src/background/background.ts",
    "src/injected/index.ts"
  ]
}
