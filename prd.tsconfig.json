{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "types": [],
    "skipLibCheck": true,
    "noEmitOnError": true,
    // The extension bundles (content, injected, background) compile through
    // this config rather than through tsconfig.app.json, so without these flags
    // the mocking logic — where every real bug so far has been found — would be
    // the one part strict mode does not cover.
    "strict": true,
    "esModuleInterop": true
  },
  "files": [
    "src/content/index.ts",
    "src/background/background.ts",
    "src/injected/index.ts"
  ]
}
