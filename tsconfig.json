{
  "compileOnSave": false,
  "compilerOptions": {
    // Strict mode is being adopted one flag at a time rather than in a single
    // sweep. These six cost nothing today. The two that remain are real work
    // and are tracked separately: `noImplicitAny` (54 errors) and
    // `strictNullChecks` (122, which also gates `strictPropertyInitialization`).
    "strict": false,
    "alwaysStrict": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["chrome"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmitHelpers": false,
     "resolveJsonModule": true
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "fullTemplateTypeCheck": true
  }
}
