{
  "compileOnSave": false,
  "compilerOptions": {
    // Strict mode, adopted one flag at a time rather than in a single sweep.
    //
    // `strictPropertyInitialization` is the one exception and is still open
    // work: it reports 117 fields that Angular assigns outside the constructor
    // (@Input, @ViewChild, values set in ngOnInit). The idiomatic fix is a
    // definite-assignment assertion on each, which is a mechanical but
    // deliberate pass — not something to switch on blind.
    "strict": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["chrome"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmitHelpers": false,
     "resolveJsonModule": true
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "fullTemplateTypeCheck": true
  }
}
